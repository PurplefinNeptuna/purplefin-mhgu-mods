#!/bin/sh
# A mod repo's pre-commit (a submodule under mods/): the workspace hook's checks for this mod alone.
# scripts/install_hooks.sh points each mod's core.hooksPath here.
set -eu
root=$(cd "$(dirname "$0")/../.." && pwd)
git diff --cached --name-only --diff-filter=ACMR -- '*.md' | "$root/scripts/doc_hook.sh"
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r python3 "$root/scripts/code_rules.py" --staged --repo .
python3 scripts/mod_distribution.py check --staged
git diff --cached --check
